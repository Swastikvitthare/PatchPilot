# =============================================================================
# PATCHPILOT Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Gemma 4 AI Configuration ---
# DigitalOcean Gradient endpoint for Gemma 4 inference
GEMMA_API_KEY=your_api_key_here
GEMMA_API_URL=https://your-gradient-endpoint.digitaloceanspaces.com/v1
GEMMA_MODEL=google/gemma-4-27b-it

# --- DigitalOcean ---
DIGITALOCEAN_API_TOKEN=your_digitalocean_token_here

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MAX_CODE_SIZE_KB=512
LOG_LEVEL=info

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=PATCHPILOT
